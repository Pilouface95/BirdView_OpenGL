        <mxCell id="b81ZyPhcDKVtZ2gRZZBu-87" value="3. 对过渡区的任意一个像素&lt;font style=&quot;font-size: 15px;&quot;&gt;`M`&lt;/font&gt;，在&lt;font style=&quot;font-size: 15px;&quot;&gt;`/_\MAP`&lt;/font&gt;中应用余弦定理即可求得&lt;font style=&quot;font-size: 15px;&quot;&gt;`/_alpha`&lt;/font&gt;的大小。&lt;br&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 15px; background-color: initial;&quot;&gt;`cosalpha=(bar(MP)^2+bar(AP)^2-bar(AM)^2)/(2*bar(AP)*bar(MP))`&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;`M`&lt;/font&gt;处的权重值即为&lt;br&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;`w_M=1-alpha*Deltaw`&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;`w_M`&lt;/font&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;乘以255即可以蒙板图像来保存此处的权重值。&lt;/span&gt;&lt;/div&gt;" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Aa顺風顺水顺财神;fontColor=default;" parent="1" vertex="1">
          <mxGeometry x="320" y="688" width="440" height="240" as="geometry" />
        </mxCell>
        <mxCell id="b81ZyPhcDKVtZ2gRZZBu-86" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;`alpha`&lt;/font&gt;" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Aa顺風顺水顺财神;fontColor=default;" parent="1" vertex="1">
