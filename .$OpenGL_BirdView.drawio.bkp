        <mxCell id="SN5FIKm86c5z7QQMbPPY-5" value="相机内参数矩阵&lt;font style=&quot;font-size: 12px;&quot;&gt;`bb{K}_{3xx3}`&lt;/font&gt;&lt;br style=&quot;font-size: 16px;&quot;&gt;畸变系数&lt;font style=&quot;font-size: 12px;&quot;&gt;`k_1~k_4`&lt;/font&gt;" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontFamily=Aa顺風顺水顺财神;" parent="1" vertex="1">
