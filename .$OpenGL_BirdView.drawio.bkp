        <mxCell id="eJONawggFBs_LTnPpK3X-1" value="Standalone version (undistortion + homography):" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Architects Daughter;" parent="1" vertex="1">
          <mxGeometry x="30" y="110" width="480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hsH988SgFplBW3_25EWf-3" value="&lt;div style=&quot;background-color: rgb(40, 42, 54); font-family: &amp;quot;Droid Sans Mono&amp;quot;, &amp;quot;monospace&amp;quot;, monospace; font-weight: normal; font-size: 14px; line-height: 19px;&quot;&gt;&lt;div style=&quot;color: rgb(248, 248, 242);&quot;&gt;&lt;span style=&quot;color: #ff79c6;&quot;&gt;#ifdef&lt;/span&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt; GL_ES&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(248, 248, 242);&quot;&gt;&lt;span style=&quot;color: #ff79c6;&quot;&gt;precision&lt;/span&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #ff79c6;&quot;&gt;mediump&lt;/span&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #ff79c6;&quot;&gt;float&lt;/span&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(248, 248, 242);&quot;&gt;&lt;span style=&quot;color: #ff79c6;&quot;&gt;#endif&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;color: rgb(248, 248, 242);&quot;&gt;&lt;span style=&quot;color: #ff79c6;&quot;&gt;uniform&lt;/span&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #ff79c6;&quot;&gt;sampler2D&lt;/span&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt; u_tex0;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(248, 248, 242);&quot;&gt;&lt;span style=&quot;color: #ff79c6;&quot;&gt;uniform&lt;/span&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #ff79c6;&quot;&gt;vec2&lt;/span&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt; u_resolution;&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;color: rgb(248, 248, 242);&quot;&gt;&lt;span style=&quot;color: #ff79c6;&quot;&gt;vec2&lt;/span&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt; fisheye_undistortion(&lt;/span&gt;&lt;span style=&quot;color: #ff79c6;&quot;&gt;vec4&lt;/span&gt;&lt;span style=&q