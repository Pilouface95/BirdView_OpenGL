        <mxCell id="L-SrhxUH0-EMiaQue9As-1" value="xOy: gl_FragCoord&lt;br style=&quot;font-size: 13px;&quot;&gt;x&#39;O&#39;y&#39;: texture coordinate system" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontFamily=Architects Daughter;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" parent="L-SrhxUH0-EMiaQue9As-3" vertex="1">
