        <mxCell id="hzWJzBgZ_R1ymZ_j08x3-27" value="`(x_3, y_3)`" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Aa顺風顺水顺财神;fontColor=default;" parent="1" vertex="1">
          <mxGeometry x="100" y="573" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hzWJzBgZ_R1ymZ_j08x3-28" value="" style="endArrow=classic;html=1;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Aa顺風顺水顺财神;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;fontColor=default;startSize=8;endSize=8;curved=1;" parent="1" source="hzWJzBgZ_R1ymZ_j08x3-14" target="hzWJzBgZ_R1ymZ_j08x3-26" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="315" y="600" as="sourcePoint" />
            <mxPoint x="135" y="620" as="targetPoint" />
            <Array as="points">
              <mxPoint x="265" y="560" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="hzWJzBgZ_R1ymZ_j08x3-26" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;rounded=0;align=left;verticalAlign=top;fontFamily=Aa顺風顺水顺财神;fontSize=20;fillColor=#d80073;strokeColor=#A50040;opacity=50;fontColor=#ffffff;" parent="1" vertex="1">
          <mxGeometry x="130" y="616" width="10" height="10" as="geometry" />
        </mxCell>
        <mxCell id="hzWJzBgZ_R1ymZ_j08x3-29" value="`...`" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Aa顺風顺水顺财神;fontColor=default;" parent="1" vertex="1">
          <mxGeometry x="225" y="550" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hzWJzBgZ_R1ymZ_j08x3-32" value="以OpenCV实现畸变校正和视角变换的步骤：" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Aa顺風顺水顺财神;fontColor=default;" parent="1" vertex="1">
          <mxGeometry x="50" y="90" width="630" height="50" as="geometry" />
        </mxCell>
        <mxCell id="hzWJzBgZ_R1ymZ_j08x3-33" value="从上面的图示来看，OpenGL的实现过程似乎是OpenCV的逆过程。实则不然。OpenCV中的畸变校正和单应性变换函数的内部实现实际上就是上图的原理，只不过从宏观流程来看，二者似乎是互为逆向的。" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Aa顺風顺水顺财神;fontColor=default;" parent="1" vertex="1">
          <mxGeometry x="45" y="1030" width="695" height="90" as="geometry" />
        </mxCell>
        <mxCell id="hzWJzBgZ_R1ymZ_j08x3-34" value="由于这里的单应性矩阵&lt;font style=&quot;font-size: 15px;&quot;&gt;`bb{H}`&lt;/font&gt;是从“原图尺寸到原图尺寸的对应点映射”计算得到的，所以上图中会存在&lt;font style=&quot;font-size: 15px;&quot;&gt;`(x_1, y_1)`&lt;/font&gt;作为中转。如果是基于“缩小后尺寸之间的映射”定义的，则不存在&lt;font style=&quot;font-size: 15px;&quot;&gt;`(x_0, y_0)-&amp;gt;(x_1, y_1)`&lt;/font&gt;，而直接得到&lt;font style=&quot;font-size: 15px;&quot;&gt;`(x_2, y_2)`&lt;/font&gt;。" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Aa顺風顺水顺财神;fontColor=default;" parent="1" vertex="1">
          <mxGeometry x="45" y="920" width="695" height="100" as="geometry" />
        </mxCell>
        <mxCell id="2pjeK994BFNvfD35jrnc-1" value="OpenGL实现鱼眼畸变校正和鸟瞰视角变换" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontFamily=Aa顺風顺水顺财神;fontColor=default;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="143" y="10" width="542" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
