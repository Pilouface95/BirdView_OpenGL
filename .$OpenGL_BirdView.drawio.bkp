        <mxCell id="hzWJzBgZ_R1ymZ_j08x3-24" value="`xx&quot;ratio&quot;`" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Aa顺風顺水顺财神;fontColor=default;" parent="1" vertex="1">
