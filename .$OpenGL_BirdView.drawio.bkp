        <mxCell id="796mAjwi3rtg2Y2Vg2Ms-7" value="对于画幅左右两侧的融合区来说，过渡方式比较简单，可以方便地用GIMP等绘图工具进行绘制。&lt;br&gt;&lt;br&gt;注：因为shader中在访问纹理像素值的函数texture2D()是在纹理坐标系下定义的，坐标值是经过归一化的。所以蒙板图像的绝对大小以及长宽比并不重要。" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Aa顺風顺水顺财神;" parent="1" vertex="1">
          <mxGeometry x="50" y="1860" width="700" height="150" as="geometry" />
        </mxCell>
        <mxCell id="796mAjwi3rtg2Y2Vg2Ms-11" value="" style="group" parent="1" vertex="1" connectable="0">
          <mxGeometry x="290" y="2040" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="796mAjwi3rtg2Y2Vg2Ms-8" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/jpeg,;" parent="796mAjwi3rtg2Y2Vg2Ms-11" vertex="1">
          <mxGeometry width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="796mAjwi3rtg2Y2Vg2Ms-9" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;maskSides&lt;/font&gt;" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontFamily=Aa顺風顺水顺财神;fontColor=#FF0000;labelBackgroundColor=#FFE599;" parent="796mAjwi3rtg2Y2Vg2Ms-11" vertex="1">
          <mxGeometry y="1" width="86" height="20" as="geometry" />
        </mxCell>
        <mxCell id="796mAjwi3rtg2Y2Vg2Ms-13" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="216" y="4840" width="394.73" height="580" as="geometry" />
        </mxCell>
        <mxCell id="796mAjwi3rtg2Y2Vg2Ms-14" value="最终结果" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=24;fontFamily=Aa顺風顺水顺财神;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="334" y="4760" width="160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="796mAjwi3rtg2Y2Vg2Ms-15" value="从上图中可以观察到：&lt;br&gt;&lt;br&gt;1. 所有融合区均过渡平滑、自然，没有出现跳变的情况。&lt;br&gt;2. 个别融合区出现的重影来源于标定过程的误差，即在标定布布置、距离测量过程中的不准确。&lt;br&gt;3. 中央车体两侧出现的黑色部分来源于视野盲区，非算法原因（该组数据并非利用实车采集得到，故相机摆放位置有不合理的情况）。" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontFamily=Aa顺風顺水顺财神;" parent="1" vertex="1">
          <mxGeometry x="69" y="5460" width="701" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
